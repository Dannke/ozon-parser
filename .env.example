# ============================================================================
#  Скопируйте файл в .env и заполните значения.
# ============================================================================

# --- Авторизация на Ozon ------------------------------------------------------
# Способ входа в Ozon ID:
#   email - вход по почте: Ozon присылает письмо с кодом на OZON_EMAIL;
#   phone - вход по телефону: способ подтверждения выбирает Ozon (QR-код,
#           звонок, SMS или письмо); автоматически проходится только письмо.
LOGIN_METHOD=email

# Gmail, привязанный к аккаунту Ozon, - тот же ящик, к которому выдан доступ
# через Gmail API (credentials.json / token.json).
OZON_EMAIL=example@gmail.com

# Телефон (нужен для LOGIN_METHOD=phone), в любом формате: +7 999 123-45-67
OZON_PHONE=+79991234567

# --- Gmail API ----------------------------------------------------------------
# Файл OAuth-клиента (тип "Desktop app") из Google Cloud Console.
GMAIL_CREDENTIALS_FILE=credentials.json
# Сюда сохраняется refresh-токен после первого входа (создаётся автоматически).
GMAIL_TOKEN_FILE=token.json
# Фильтр отправителя для поиска письма с кодом. Держите его узким:
# свободные слова вроде "ozon" матчат и посторонних отправителей.
GMAIL_SENDER_FILTER=from:(ozon.ru OR ozon.com)
# Сколько секунд ждать письмо с кодом.
GMAIL_WAIT_TIMEOUT=180
# Интервал опроса почты, секунды.
GMAIL_POLL_INTERVAL=5

# --- Файлы --------------------------------------------------------------------
COOKIES_FILE=cookies.json
OUTPUT_CSV=data/products.csv

# --- Поведение браузера -------------------------------------------------------
# 0 — окно браузера видно (для ручного входа и отладки), 1 — фон.
HEADLESS=0
# Какой браузер запускать. Пусто - Chromium, который ставит сам Playwright.
# Если он не стартует (Windows: 'side-by-side configuration is incorrect'),
# укажите уже установленный в системе браузер: msedge или chrome.
BROWSER_CHANNEL=

# Таймаут загрузки страницы, миллисекунды.
PAGE_TIMEOUT=60000
# Пауза между SKU, секунды (снижает риск бана по частоте запросов).
REQUEST_DELAY=3.0
# Карточки открываются не чаще раза в столько секунд, как бы быстро ни шёл
# разбор: Ozon блокирует по частоте страниц. 6.5 - не чаще ~9 в минуту
# (07.10.2026: ~14 в минуту - капча на 14-й минуте). 0 - без предела.
PAGE_INTERVAL=6.5
# Сколько раз повторять SKU при ошибке.
MAX_RETRIES=2
# Сколько раз перезапускать браузер, если он упал посреди списка SKU.
MAX_BROWSER_RESTARTS=2
# Предохранитель: столько SKU подряд без данных (кроме 404 «товара нет») -
# и прогон останавливается: это признак блокировки Ozon, долбить дальше
# бессмысленно. 0 - не останавливаться.
MAX_CONSECUTIVE_FAILURES=10
# Меньший порог для самого явного признака блокировки: столько SKU подряд, на
# которых антибот-проверка не прошла за CHALLENGE_TIMEOUT. Такой SKU не
# повторяется, а в logs/ остаётся снимок экрана. 0 - не учитывать отдельно.
MAX_CONSECUTIVE_CHALLENGES=3

# Сколько ждать полной загрузки (load) сверх domcontentloaded, мс.
LOAD_STATE_TIMEOUT=15000
# Пауза после загрузки страницы перед запросом к API из вкладки, мс. Разбор
# одного HTML (parser.price_source: html в config.yaml) её не ждёт.
PAGE_SETTLE_MS=1500
# Сколько ждать, пока антибот-проверка Ozon пройдёт сама, секунды.
CHALLENGE_TIMEOUT=30

# Таймаут появления поля телефона / кода на форме входа, мс.
ELEMENT_TIMEOUT=20000
# Задержка между символами при вводе, мс.
TYPING_DELAY_MS=80
# Сколько ждать входа человека в режиме get_cookies.py --manual, секунды.
MANUAL_LOGIN_TIMEOUT=300

# Через сколько собранных товаров сбрасывать результат в хранилище.
# На длинном списке это страховка: сбой на последних SKU не обнулит прогон.
# 0 - сохранять только в самом конце.
BATCH_SIZE=50

# --- Хранилище результата: csv | postgres | clickhouse ------------------------
STORAGE=csv

# PostgreSQL: и для STORAGE=postgres (таблица PG_TABLE), и для конвейера
# python -m ozon_parser (sku_panel, price_history, parse_runs ...).
# С хоста к базе из docker-compose (порт POSTGRES_PORT):
#   PG_DSN=postgresql://ozon:change-me@localhost:5433/ozon
# Спецсимволы в пароле внутри DSN нужно кодировать (%40 вместо @ и т.п.).
PG_DSN=postgresql://user:password@localhost:5432/ozon
PG_TABLE=ozon_products

# ClickHouse (STORAGE=clickhouse)
CH_HOST=localhost
CH_PORT=8123
CH_USER=default
CH_PASSWORD=
CH_DATABASE=default
CH_TABLE=ozon_products

# --- Оповещения о ежедневном прогоне -----------------------------------------
# Telegram: токен бота от @BotFather и id чата, куда писать. Сообщение уходит
# только о проблемах: прогон не удался, копия базы не снята. Пусто - выключено.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# «Пульс» для сервиса мониторинга (например, healthchecks.io): после успешного
# прогона открывается этот адрес, после неудачного - адрес + /fail. Если
# пульса нет дольше расписания (компьютер выключен или спал), сервис
# предупредит сам. Пусто - выключено.
HEALTHCHECK_URL=

# --- Конвейер discovery -> panel -> parse -------------------------------------
# Настройки конвейера (категории, размер panel, расписание) - в config.yaml.
# Здесь можно указать другой файл.
PIPELINE_CONFIG=config.yaml

# --- PostgreSQL в docker-compose ----------------------------------------------
# docker compose up -d поднимает базу с этими учётными данными. Внутри compose
# парсер подключается к ней сам (PG_DSN собирается в docker-compose.yml).
POSTGRES_USER=ozon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ozon
# Порт на localhost хоста (5433 - чтобы не мешать локальному PostgreSQL).
POSTGRES_PORT=5433
